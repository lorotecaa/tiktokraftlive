# El panel se enlaza solo a este equipo por seguridad. No lo expongas a Internet.
HOST=127.0.0.1
PORT=3180

# Límite de comandos enviados al servidor por segundo.
COMMANDS_PER_SECOND=5

# En Render apunta esta ruta al punto de montaje de su disco persistente.
# Ejemplo: /var/data
# TIKTOKRAFT_DATA_DIR=/var/data

# Alternativa gratuita: configuración persistente en Supabase.
# Define ambas variables en Render. La clave secreta solo se usa en el servidor.
# Usa la Project URL o la REST URL de Supabase; ambas son admitidas.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# Usa la clave pública para registro e inicio de sesión. Si no se define,
# la app conserva compatibilidad usando la clave secreta del servidor.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SECRET_KEY=sb_secret_xxx

# Activación automática de Pro con el Checkout Web de Wompi Colombia.
# Estas cuatro credenciales son de un mismo comercio Wompi en producción.
# Guárdalas SOLO en Render; nunca en el navegador ni en Git.
# APP_URL=https://tiktokraft.loroland.pro
# WOMPI_PUBLIC_KEY=pub_prod_xxx
# WOMPI_INTEGRITY_SECRET=prod_integrity_xxx
# WOMPI_EVENTS_SECRET=prod_events_xxx
# WOMPI_PRIVATE_KEY=prv_prod_xxx
